{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"vite --host\" \"tsx watch --env-file .env server/src/index.ts\"",
    "dev:client": "vite --host",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:full": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
    "lint:no-cache": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config=server/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=server/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=server/drizzle.config.ts",
    "db:seed:franca-dev": "tsx --env-file .env server/src/db/seeds/franca-dev.seed.ts",
    "certs:install": "mkcert -install",
    "certs:generate": "node scripts/generate-dev-certs.mjs",
    "setup:dev": "node scripts/generate-dev-certs.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@hono/zod-validator": "^0.8.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.18",
    "ioredis": "^5.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "pino": "^10.3.1",
    "postcss": "^8.5.14",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.4",
    "@types/pino": "^7.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "pg": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-mkcert": "^1.17.12",
    "vitest": "^4.1.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

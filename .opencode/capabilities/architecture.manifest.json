    "docs/obsidian/project-operating-system/00-SYSTEM/SYSTEM_CONTRACT.md",
    "docs/obsidian/project-operating-system/00-SYSTEM/EVENT_STREAM.md",
    "docs/obsidian/wiki/decisions/**/*.md",
    "docs/obsidian/wiki/patterns/architecture-*",
    "docs/obsidian/wiki/patterns/database-*"
  ],
  "cold_docs": [
    "docs/obsidian/project-operating-system/04-AGENTS/*.md",
    "docs/obsidian/project-operating-system/08-SECURITY/*.md",
    "docs/obsidian/project-operating-system/99-TEMPLATES/generated/*",

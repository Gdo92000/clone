{
  "capability": "documentation",
  "description": "Documentação, README, guias, manuais, wikis, comentários",
  "version": "2.0.0",
  "max_bootstrap_tokens": 500,
  "max_working_tokens": 8000,
  "max_retrieval_depth": 2,
  "hot_docs": [],
  "warm_docs": [
    "docs/obsidian/project-operating-system/03-ENGINEERING/CODE_STANDARDS.md",
    "docs/obsidian/project-operating-system/03-ENGINEERING/FOLDER_STRUCTURE.md",
    "docs/obsidian/wiki/**/*.md",
    "docs/obsidian/wiki/patterns/**/*.md"
  ],
  "cold_docs": [
    "docs/obsidian/project-operating-system/00-SYSTEM/CONTEXT_BUDGET_GOVERNANCE.md",
    "docs/obsidian/project-operating-system/04-AGENTS/*.md",
    "docs/obsidian/project-operating-system/08-SECURITY/*.md",
    "docs/obsidian/project-operating-system/99-TEMPLATES/**",
    "docs/obsidian/wiki/patterns/claude-api/**",
    "docs/obsidian/wiki/log.md",
    "docs/obsidian/archive/**"
  ],
  "allowed_skills": [
    "obsidian-markdown",
    "documentation-patterns"
  ],
  "output_budget": {
    "max_preamble_chars": 240,
    "no_repeat_user_input": true,
    "prefer_tables": true,
    "max_items_before_summary": 5,
    "truncate_grep_at": 20
  }
}

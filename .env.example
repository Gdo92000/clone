# -----------------------
# BANCO DE DADOS (POSTGRES ONLY)
# -----------------------
DATABASE_URL="postgresql://postgres:gdo9sol@localhost:5433/clone"

DATABASE_URL_POOLER=postgresql://user:gdo9sol@localhost:5433/clone

# JWT Secret (OBRIGATÓRIO em produção)
JWT_SECRET=dev-secret-change-in-production

# CORS — origens permitidas separadas por vírgula (obrigatório em produção)
# Ex: https://meudominio.com,https://www.meudominio.com
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3001

# Ambiente (development, production, test)
NODE_ENV=development

# Porta do servidor HTTP (default: 3001)
PORT=3001

# Provedor de autenticação (local, firebase)
AUTH_PROVIDER=local

# Redis URL (opcional — usado para rate limit distribuído)
REDIS_URL=

# Nível de log (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=debug

# Tamanho máximo do corpo da requisição em bytes (default: 1_000_000)
MAX_BODY_SIZE=1000000

# Número máximo de tentativas de login antes do bloqueio temporário
LOGIN_MAX_ATTEMPTS=5

# Duração do bloqueio em minutos após exceder tentativas
LOGIN_LOCKOUT_MINUTES=15

# Fonte única de verdade para mock

# Modo mock geral (legacy)
# VITE_MOCK=true

# Nova fonte única
# VITE_MOCK_MODE=true

# Mock por domínio
# VITE_MOCK_RESTAURANTS=true
# VITE_MOCK_ORDERS=true
# VITE_MOCK_GEOCODING=true

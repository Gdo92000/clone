{
	"$schema": "https://opencode.ai/config.json",

	"instructions": [
		"AGENTS.md",
		".opencode/ag-kit-main/AGENT_FLOW.md", 
	],

	"plugin": [
		"./.opencode/plugins/flux-delivery-tools.ts"
	],

	"skills": {
		"path": "./.opencode/skills"
	},

	"tools": {
		"concurrency_limit": true,
		"max_output_tokens_per_call": true,
		"auto_truncate_long_outputs": true
	},

	"permission": {
		"edit": "allow",
		"read": "allow",
		"glob": "allow",
		"grep": "allow",
		"lsp": "allow",
		"skill": "allow",
		"websearch": "allow",
		"webfetch": "allow",
		"bash": {
			"*": "allow",
			"rm -rf *": "deny",
			"sudo *": "deny",
			"npm prime *": "deny",
			"*drizzle-kit db:push*": "ask",
			"*drizzle-kit migrate*": "ask",
			"*drop*": "ask"
		}
	},

	"compaction": {
		"auto": true,
		"prune": true,
		"reserved": 10000
	},

	"watcher": {
		"ignore": [
			"node_modules/**", 
			"dist/**", 
			".git/**",
			"server/drizzle/**",
			"**/.DS_Store",
			"**/package-lock.json"
		]
	},

	"mcp": {
		"stitch": {
			"type": "remote",
			"url": "https://stitch.googleapis.com/mcp",
			"enabled": true,
			"timeout_ms": 10000
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			},
			"enabled": true,
			"timeout_ms": 15000
		},
		"playwright": {
			"type": "local",
			"command": ["npx", "-y", "@playwright/mcp@latest"],
			"enabled": true
		},
		"shadcn-ui": {
			"type": "local",
			"command": ["npx", "-y", "@jpisnice/shadcn-ui-mcp-server"],
			"enabled": true
		}
	}
}
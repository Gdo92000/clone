{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "server/drizzle/**",
      "**/.DS_Store",
      "**/package-lock.json"
    ]
  },
  "plugin": [
    "./.opencode/plugins/flux-delivery-tools.ts"
  ],
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-9624e40d-fa93-4c55-8d8f-8d952ffbcca7"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "shadcn-ui": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@jpisnice/shadcn-ui-mcp-server"
      ],
      "enabled": true
    }
  },
  "instructions": [
    "docs/_index.md",
    "AGENTS.md",
    ".opencode/ag-kit-main/AGENT_FLOW.md"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "npm prime *": "deny",
      "*drizzle-kit db:push*": "ask",
      "*drizzle-kit migrate*": "ask",
      "*drop*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "tools": {
    "concurrency_limit": true,
    "max_output_tokens_per_call": true,
    "auto_truncate_long_outputs": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}